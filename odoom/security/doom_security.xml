<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Everyone can chart everyone's kills; a user only records their own. -->
    <record id="rule_doom_kill_own" model="ir.rule">
        <field name="name">Doom kill: record own kills</field>
        <field name="model_id" ref="model_doom_kill"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
    </record>

    <record id="rule_doom_kill_system" model="ir.rule">
        <field name="name">Doom kill: administrators manage all kills</field>
        <field name="model_id" ref="model_doom_kill"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
    </record>

</odoo>
